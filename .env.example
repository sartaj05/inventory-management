# PostgreSQL
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_db_password

# Backend
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://postgres:change_this_db_password@db:5432/inventory_db
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000
LOW_STOCK_THRESHOLD=5
SECRET_KEY=replace_with_a_random_secret_key_minimum_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
WEB_CONCURRENCY=1

# Frontend build-time API URL
VITE_API_URL=http://localhost:8000
